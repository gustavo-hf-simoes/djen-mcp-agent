# Database: use DATABASE_URL or the individual DB_* variables.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/djen_db

# Independent DJEN ingestion worker; set the intentional start date before running it.
DJEN_SYNC_NUMERO_OAB=69161
DJEN_SYNC_UF_OAB=PR
DJEN_SYNC_DATA_INICIO_BACKFILL=
DJEN_SYNC_DIAS_LOOKBACK=3
DJEN_SYNC_DIAS_BACKFILL_POR_CICLO=3
DJEN_SYNC_INTERVALO_MINUTOS=60

# Meta WhatsApp Cloud API webhook.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Generate two independent 32-byte keys and store them outside source control.
WHATSAPP_DATA_ENCRYPTION_KEY=
WHATSAPP_PHONE_HASH_KEY=

# Local encrypted attachment storage; the downloader is added in a later step.
WHATSAPP_STORAGE_PATH=./storage/clientes